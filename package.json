{
  "name": "@gusnips/hikerapi",
  "version": "0.1.0",
  "author": "Gustavo Salomé (gusnips)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/hikerapi.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "devDependencies": {
    "@gusnips/oxlint": "^0.2.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsdown": "0.23.7",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/gusnips/hikerapi/issues"
  },
  "description": "Unofficial TypeScript SDK for the HikerAPI Instagram data API: profiles, posts, reels, stories, comments, followers, hashtags, locations and search",
  "engines": {
    "node": ">=18.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/gusnips/hikerapi#readme",
  "keywords": [
    "hikerapi",
    "instagram",
    "scraping",
    "social-media",
    "api-client",
    "typescript"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts && oxfmt src",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "format": "oxfmt",
    "test": "bun test",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build",
    "format:check": "oxfmt --check"
  },
  "types": "dist/index.d.ts"
}
